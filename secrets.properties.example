# Copy this file to secrets.properties and fill in your own values. secrets.properties is git-ignored.

# YouTube Data API v3 key (Google Cloud console). Can also be entered in the app's Settings.
YOUTUBE_API_KEY=

# Firebase, for sign-in, profiles and reviews. Leave blank to run without them.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
GOOGLE_WEB_CLIENT_ID=

# Optional: your own signing key in keystore/essayfinder.jks. Without it, the debug key is used.
KEYSTORE_PASSWORD=
